generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ORGANIZATION_ADMIN
  SUPERVISOR
  AGENT
  VIEWER
}

enum CallStatus {
  INITIATED
  RINGING
  ANSWERED
  COMPLETED
  FAILED
  NO_ANSWER
  BUSY
  CANCELLED
}

enum BillingPolicy {
  PER_MINUTE_ROUNDED_UP
  PER_SECOND
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users               User[]
  knowledgeBases      KnowledgeBase[]
  agents              AIAgent[]
  calls               Call[]
  customers           Customer[]
  organizationBalance OrganizationBalance?
  packageAssignments  PackageAssignment[]
  billingTransactions BillingTransaction[]
  usageRecords        UsageRecord[]
  ivrMenus            IVRMenu[]
  callQueues          CallQueue[]
  campaigns           Campaign[]
  smsLogs             SMSLog[]
  whatsappLogs        WhatsAppLog[]
  webhookEvents       WebhookEvent[]
}

model User {
  id             String        @id @db.Uuid
  name           String?
  email          String        @unique
  role           Role          @default(VIEWER)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([organizationId])
  @@index([email])
}

model BillingConfig {
  id                     String        @id @default(cuid())
  currency               String        @default("NPR")
  billingPolicy          BillingPolicy @default(PER_MINUTE_ROUNDED_UP)
  aiCallRatePerMinute    Float         @default(5)
  providerCostPerMinute  Float         @default(0)
  customerPricePerMinute Float         @default(5)
  grossMargin            Float         @default(0)
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
}

model TelephonyProvider {
  id             String   @id @default(cuid())
  name           String
  providerType   String
  enabled        Boolean  @default(true)
  configuration  String   // Encrypted JSON string
  capabilities   Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model PhoneNumberMapping {
  id             String   @id @default(cuid())
  phoneNumber    String   @unique
  providerId     String
  organizationId String
  agentId        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model KnowledgeBase {
  id             String       @id @default(cuid())
  name           String
  content        String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  agents AIAgent[]

  @@index([organizationId])
}

model AIAgent {
  id              String        @id @default(cuid())
  name            String
  greeting        String?
  businessInfo    String?
  systemPrompt    String?
  voiceId         String?
  language        String?
  temperature     Float?
  maxDuration     Int?
  isTemplate      Boolean       @default(false)
  knowledgeBaseId String?
  knowledgeBase   KnowledgeBase? @relation(fields: [knowledgeBaseId], references: [id], onDelete: SetNull)
  organizationId  String
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([organizationId])
}

model Customer {
  id             String       @id @default(cuid())
  phoneNumber    String
  name           String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  
  calls          Call[]

  @@index([organizationId])
  @@index([phoneNumber])
}

model Call {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerId       String?
  customer         Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  agentId          String?
  
  provider         String?
  providerCallId   String?
  direction        String       @default("OUTBOUND") // INBOUND, OUTBOUND
  fromNumber       String?
  toNumber         String?
  
  status           CallStatus   @default(INITIATED)
  
  startedAt        DateTime?
  answeredAt       DateTime?
  endedAt          DateTime?
  durationSeconds  Int          @default(0)
  billableMinutes  Int          @default(0)
  failureReason    String?
  
  recordingUrl     String?
  transcriptText   String?
  summaryText      String?
  sentimentScore   Float?
  costNPR          Float        @default(0)
  
  providerMetadata Json?
  
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  usageRecords     UsageRecord[]

  @@index([organizationId])
  @@index([customerId])
  @@index([createdAt])
  @@index([providerCallId])
}

model OrganizationBalance {
  id               String       @id @default(cuid())
  remainingMinutes Int          @default(0)
  organizationId   String       @unique
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  updatedAt        DateTime     @updatedAt

  @@index([organizationId])
}

model Package {
  id              String   @id @default(cuid())
  name            String
  minutes         Int
  ratePerMinute   Float
  calculatedPrice Float
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  assignments     PackageAssignment[]
}

model PackageAssignment {
  id                      String       @id @default(cuid())
  organizationId          String
  organization            Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  packageId               String?
  package                 Package?     @relation(fields: [packageId], references: [id], onDelete: SetNull)
  
  purchasedMinutes        Int
  usedMinutes             Int          @default(0)
  remainingMinutes        Int
  packagePrice            Float
  ratePerMinuteAtPurchase Float
  
  status                  String       @default("ACTIVE") // ACTIVE, EXHAUSTED, EXPIRED
  purchasedAt             DateTime     @default(now())
  expiresAt               DateTime?
  
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  @@index([organizationId])
}

model BillingTransaction {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type             String       // DEDUCTION, ADDITION, ADJUSTMENT
  minutes          Int
  balanceAfter     Int
  description      String?
  referenceId      String?      // callId or auditId
  createdAt        DateTime     @default(now())

  @@index([organizationId])
}

model AuditLog {
  id               String       @id @default(cuid())
  actorUserId      String
  organizationId   String
  action           String
  previousBalance  Int
  adjustment       Int
  newBalance       Int
  reason           String
  createdAt        DateTime     @default(now())

  @@index([organizationId])
}

model UsageRecord {
  id              String       @id @default(cuid())
  callId          String?
  call            Call?        @relation(fields: [callId], references: [id], onDelete: SetNull)
  billableMinutes Int          @default(0)
  providerCost    Float        @default(0)
  customerPrice   Float        @default(0)
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt       DateTime     @default(now())

  @@index([organizationId])
  @@index([callId])
}

model IdempotencyKey {
  key       String   @id
  createdAt DateTime @default(now())
}


model IVRMenu {
  id              String       @id @default(cuid())
  name            String
  welcomeAudioUrl String?
  keypressRoutes  Json?
  timeoutSeconds  Int          @default(10)
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([organizationId])
}

model CallQueue {
  id                   String       @id @default(cuid())
  name                 String
  strategy             String       @default("ROUND_ROBIN")
  maxWaitTimeSeconds   Int          @default(300)
  organizationId       String
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@index([organizationId])
}

model Campaign {
  id             String       @id @default(cuid())
  name           String
  type           String       @default("VOICE_BROADCAST") // VOICE_BROADCAST, SMS
  status         String       @default("PENDING") // PENDING, RUNNING, COMPLETED, FAILED
  totalContacts  Int          @default(0)
  processedCount Int          @default(0)
  successCount   Int          @default(0)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
}

model SMSLog {
  id               String       @id @default(cuid())
  recipient        String
  message          String
  status           String
  providerResponse String?
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([organizationId])
}

model WhatsAppLog {
  id             String       @id @default(cuid())
  recipient      String
  templateName   String
  status         String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
}

model WebhookEvent {
  id             String       @id @default(cuid())
  eventType      String
  payload        Json
  status         String       @default("PENDING") // PENDING, SUCCESS, FAILED
  responseCode   Int?
  retryCount     Int          @default(0)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
}
